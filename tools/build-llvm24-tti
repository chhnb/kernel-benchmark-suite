#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
build="$root/build/llvm24-tti"
mkdir -p "$build"
if [[ ${1:-} != --search-only ]]; then
  lc=${LLVM24_CONFIG:-"$root/toolchains/llvm24-tti/root/usr/lib/llvm-24/bin/llvm-config"}
  [[ $("$lc" --version) == 24.* ]] || { echo "LLVM24 required" >&2; exit 2; }
  read -r -a flags <<< "$("$lc" --cxxflags)"
  read -r -a libs <<< "$("$lc" --ldflags --link-shared --libs core irreader analysis amdgpu nvptx | tr '\n' ' ')"
  ${CXX:-g++} ${CPPFLAGS:-} "${flags[@]}" -std=c++17 -fexceptions -O2 "$root/tools/llvm24_tti_main.cpp" "${libs[@]}" -o "$build/llvm24-tti"
  if [[ ${1:-} == --worker-only ]]; then exit 0; fi
fi
lc=${LLVM_CONFIG:-/home/chh/darm-artifacts-repro/build/bin/llvm-config}
read -r -a flags <<< "$("$lc" --cxxflags)"
read -r -a libs <<< "$("$lc" --ldflags --libs core irreader asmparser analysis transformutils scalaropts ipo instcombine vectorize amdgpu x86 nvptx --system-libs | tr '\n' ' ')"
# The original DARM fork and packaged LLVM 12 expose different APIs.
if printf '%s\n' '#include "llvm/Support/InstructionCost.h"' |     ${CXX:-g++} "${flags[@]}" -x c++ -fsyntax-only - >/dev/null 2>&1; then
  flags+=(-DFUSION_PACKAGED_LLVM12)
  read -r -a libs <<< "$("$lc" --ldflags --link-shared --libs --system-libs | tr '\n' ' ')"
fi
${CXX:-g++} ${CPPFLAGS:-} "${flags[@]}" -std=c++17 -fexceptions -O2 \
  "$root/tools/offline_tti_layout.cpp" "${libs[@]}" ${LDFLAGS:-} -o "$build/offline-tti-layout"
objects=()
for source in ir_pressure fusion_search logical_region_state darm_pair_engine/RegionAnalyzer darm_pair_engine/RegionMelder darm_pair_engine/RegionReplicator darm_pair_engine/CFMelderUtils darm_pair_engine/InstructionMatch; do
  obj="$build/$(basename "$source").o"
  ${CXX:-g++} ${CPPFLAGS:-} "${flags[@]}" -std=c++17 -fexceptions -O2 -DFUSION_DETERMINISTIC_REGION_ORDER -I"$root/tools" -I"$root/tools/darm_pair_engine" -c "$root/tools/$source.cpp" -o "$obj"
  objects+=("$obj")
done
${CXX:-g++} ${CPPFLAGS:-} "${flags[@]}" -std=c++17 -fexceptions -O2 -DFUSION_DETERMINISTIC_REGION_ORDER -I"$root/tools" -I"$root/tools/darm_pair_engine" "$root/tools/fusion_search_llvm24_main.cpp" "${objects[@]}" "${libs[@]}" ${LDFLAGS:-} -o "$build/fusion-search-llvm24"
