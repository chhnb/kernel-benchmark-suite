#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
export LLVM_CONFIG=${LLVM_CONFIG:-"$root/build/llvm12-jammy/usr/bin/llvm-config-12"}
export LD_LIBRARY_PATH="$root/build/llvm12-jammy/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
export LLVM24_LIBDIR=${LLVM24_LIBDIR:-"$root/build/llvm24-pinned/lib"}
bindir=$("$LLVM_CONFIG" --bindir)
search="$root/build/llvm24-tti/fusion-search-llvm24"
python3 "$root/tests/fusion-search/check-single-branch-b2b.py" "$search" "$root/tools/run-llvm24-tti" "$bindir/opt" "$bindir/clang" "$root/build/decision-fuse/decision-greedy"
python3 "$root/tests/fusion-search/check-b2b-anchor.py" "$search" "$root/tools/run-llvm24-tti" "$bindir/opt"
python3 "$root/tests/fusion-search/check-darm-merge-flags.py" "$search" "$root/tools/run-llvm24-tti" "$bindir/opt"
python3 "$root/tests/fusion-search/check-darm-determinism.py" "$search" "$root/tools/run-llvm24-tti"
python3 "$root/tests/fusion-search/observe-b2b-anchor.py" "$search" "$root/tools/run-llvm24-tti" "$bindir/opt"
python3 "$root/tests/decision-model/check_independent_region_exits.py" "$search" "$bindir/opt" "$bindir/clang"
python3 "$root/tests/decision-model/check_sibling_loops.py" "$search" "$bindir/opt" "$bindir/clang"
python3 "$root/tests/fusion-search/check-trial-queue.py"
queue_test=$(mktemp -d)
trap 'rm -rf -- "$queue_test"' EXIT
"${CXX:-c++}" -std=c++17 -O2 -Wall -Wextra -I"$root/tools" \
  "$root/tests/fusion-search/check-incremental-queue.cpp" -o "$queue_test/check"
"$queue_test/check"
read -r -a anchor_cxxflags <<< "$("$LLVM_CONFIG" --cxxflags)"
read -r -a anchor_libs <<< "$("$LLVM_CONFIG" --ldflags --libs core asmparser --system-libs | tr '\n' ' ')"
if printf '%s\n' '#include "llvm/Support/InstructionCost.h"' | \
    "${CXX:-c++}" "${anchor_cxxflags[@]}" -x c++ -fsyntax-only - >/dev/null 2>&1; then
  read -r -a anchor_libs <<< "$("$LLVM_CONFIG" --ldflags --link-shared --libs --system-libs | tr '\n' ' ')"
fi
"${CXX:-c++}" "${anchor_cxxflags[@]}" -std=c++17 -I"$root/tools" \
  "$root/tests/fusion-search/check-anchor-condition.cpp" "${anchor_libs[@]}" -o "$queue_test/anchor-condition"
"$queue_test/anchor-condition"
read -r -a condition_libs <<< "$("$LLVM_CONFIG" --ldflags --libs core irreader support --system-libs | tr '\n' ' ')"
"${CXX:-c++}" "${anchor_cxxflags[@]}" -std=c++17 -I"$root/tools" \
  "$root/tests/decision-model/condition_check.cpp" "${condition_libs[@]}" -o "$queue_test/condition-check"
python3 "$root/tests/decision-model/condition_check.py" "$queue_test/condition-check" "$bindir/clang"
"${CXX:-c++}" "${anchor_cxxflags[@]}" -std=c++17 -I"$root/tools" \
  "$root/tests/fusion-search/check-b2b-anchor-segments.cpp" \
  "$root/build/llvm24-tti/b2b_anchor.o" "$root/build/llvm24-tti/b2b_anchor_observe.o" "${anchor_libs[@]}" -o "$queue_test/anchor-segments"
"$queue_test/anchor-segments"
"${CXX:-c++}" "${anchor_cxxflags[@]}" -std=c++17 -I"$root/tools/darm_pair_engine" -I"$root/tools" \
  "$root/tests/fusion-search/check-r2r-integer-gaps.cpp" "${anchor_libs[@]}" -o "$queue_test/r2r-integer-gaps"
"$queue_test/r2r-integer-gaps"
read -r -a emitter_libs <<< "$("$LLVM_CONFIG" --ldflags --link-shared --libs --system-libs | tr '\n' ' ')"
"${CXX:-c++}" "${anchor_cxxflags[@]}" -std=c++17 -I"$root/tools" \
  "$root/tests/fusion-search/check-b2b-linear-emitter.cpp" \
  "$root"/build/llvm24-tti/*.o "${emitter_libs[@]}" -o "$queue_test/linear-emitter"
emitter_fixture="$root/tests/fusion-search/b2b-anchor/auto-guard"
"$queue_test/linear-emitter" "$emitter_fixture.ll" > "$queue_test/auto-fused.ll"
"$bindir/opt" -O2 -verify-each -S "$queue_test/auto-fused.ll" -o "$queue_test/auto-opt.ll"
"$bindir/clang" -O2 "$emitter_fixture-driver.c" "$emitter_fixture.ll" "$queue_test/auto-opt.ll" \
  -o "$queue_test/auto-check"
"$queue_test/auto-check"
python3 "$root/tests/fusion-search/check-score-fingerprints.py"
python3 "$root/tests/fusion-search/check-tti-quotes.py"
python3 "$root/tests/fusion-search/check-commit-score-invalidation.py"
python3 "$root/tests/fusion-search/check-normalize-commit.py" "$root/build/decision-fuse/decision-greedy" "$bindir/opt"
