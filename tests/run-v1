#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
export LLVM_CONFIG=${LLVM_CONFIG:-"$root/build/llvm12-jammy/usr/bin/llvm-config-12"}
export LD_LIBRARY_PATH="$root/build/llvm12-jammy/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
export LLVM24_LIBDIR=${LLVM24_LIBDIR:-"$root/build/llvm24-pinned/lib"}
bindir=$("$LLVM_CONFIG" --bindir)
search="$root/build/llvm24-tti/fusion-search-llvm24"
python3 "$root/tests/fusion-search/check-single-branch-b2b.py" "$search" "$root/tools/run-llvm24-tti" "$bindir/opt" "$bindir/clang" "$root/build/decision-fuse/decision-greedy"
python3 "$root/tests/decision-model/check_independent_region_exits.py" "$search" "$bindir/opt" "$bindir/clang"
python3 "$root/tests/decision-model/check_sibling_loops.py" "$search" "$bindir/opt" "$bindir/clang"
python3 "$root/tests/fusion-search/check-trial-queue.py"
queue_test=$(mktemp -d)
trap 'rm -rf -- "$queue_test"' EXIT
"${CXX:-c++}" -std=c++17 -O2 -Wall -Wextra -I"$root/tools" \
  "$root/tests/fusion-search/check-incremental-queue.cpp" -o "$queue_test/check"
"$queue_test/check"
python3 "$root/tests/fusion-search/check-b2b-recipe.py"
python3 "$root/tests/fusion-search/check-score-fingerprints.py"
python3 "$root/tests/fusion-search/check-tti-quotes.py"
python3 "$root/tests/fusion-search/check-commit-score-invalidation.py"
python3 "$root/tests/fusion-search/check-incremental-ir.py"
python3 "$root/tests/fusion-search/check-b2b-capsule.py"
python3 "$root/tests/fusion-search/check-isolated-greedy.py"
python3 "$root/tests/fusion-search/check-isolated-greedy.py" --external
python3 "$root/tests/fusion-search/check-isolated-greedy.py" --memory
python3 "$root/tests/fusion-search/check-isolated-greedy.py" --multi
