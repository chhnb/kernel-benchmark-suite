python3 "$suite/tests/postopt/test_profile.py"

"$suite/build/fusion-search/check-postopt-block_work"

python3 "$suite/tests/postopt/test_weighted_bounds.py"

python3 "$suite/tests/postopt/check_cleanup.py"
